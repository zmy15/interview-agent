# ============================================
# Interview Agent 打包版默认配置
# ============================================
# 本文件由打包流程内置（config.py 冻结分支加载）。
# 安装程序会把它复制到安装目录；安装目录里的 .env 优先级更高，
# 用户编辑那一份即可，改完重启应用生效。
#
# 语音（STT/TTS）与 RAG 的依赖未打入包体（默认关闭且体积大），
# 需要这些功能请使用源码方式运行（start.bat / start.sh）。

# ── 大模型（必填项可在安装后于界面直接填写，仅存本地浏览器） ──
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# ── 单用户免登录（桌面客户端默认，数据归属本机固定账号） ──
AUTH_REQUIRED=false

# ── 功能开关 ──
# 截图答题：开启（需要所选模型支持图片输入）
SCREENSHOT_ENABLED=true
# 系统音频捕获：依赖 STT 微服务，打包版未包含，保持关闭
SYSTEM_AUDIO_ENABLED=false
# RAG 向量知识库：依赖 torch 等重依赖，打包版未包含
RAG_ENABLED=false
# 语音识别 / 合成：打包版未包含
VOICE_ENABLED=false
STT_ENABLED=false
TTS_ENABLED=false

# ── HuggingFace 镜像（模型下载走镜像，国内免超时） ──
HF_ENDPOINT=https://hf-mirror.com
