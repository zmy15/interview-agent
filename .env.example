DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING_ENABLED=true
DEEPSEEK_REASONING_EFFORT=high
AVAILABLE_MODELS=deepseek-v4-pro,deepseek-v4-flash
EMBEDDING_MODEL=all-MiniLM-L6-v2
# --- HuggingFace 镜像（国内用户必配）---
# 国内无法访问 huggingface.co，使用镜像站下载模型
HF_ENDPOINT=https://hf-mirror.com
# 本地缓存目录，避免重复下载（默认为项目目录下的 hf_cache）
# HF_HOME=./hf_cache
CHROMA_PERSIST_PATH=./chroma_data
VECTOR_SEARCH_TOP_K=3

# --- 上下文窗口管理 ---
# DeepSeek V4 支持 1M tokens 上下文窗口
# MAX_CONTEXT_TOKENS: 总 token 预算（默认 800K，留 200K 余量给输出）
# SYSTEM_RESERVED_TOKENS: 为 system 消息（JD/简历/提示模板）预留的 token 数
# MAX_CONTEXT_TOKENS=800000
# SYSTEM_RESERVED_TOKENS=8000
# 日志等级: DEBUG / INFO / WARNING / ERROR（默认 INFO）

LOG_LEVEL=INFO

# RAG 检索增强开关（true=开启，false=关闭）
# - 开启前需安装 RAG 依赖：pip install -r requirements-rag.txt
# - Docker 部署时通过 SKIP_RAG 控制依赖安装，详见 docker-compose.yml
# - 无 CUDA 环境也可使用（自动 CPU 模式），但 torch 包体积较大（~2GB）
RAG_ENABLED=false

# ── 独立窗口模式（python desktop.py 或 start_app.bat）──
# 服务监听地址与端口（独立窗口默认仅本机可访问）
HOST=127.0.0.1
PORT=8000

# 窗口尺寸
DESKTOP_WIDTH=1280
DESKTOP_HEIGHT=800

# 窗口置顶（true=始终显示在其他窗口之上）
DESKTOP_TOPMOST=true

# 从屏幕捕获中排除窗口（true=截屏/录屏看不到窗口内容）
# 注意：仅在 native 窗口（pywebview）下真正生效；
#       若回退到浏览器 --app 模式，受 Windows 跨进程限制无法生效。
DESKTOP_CAPTURE_EXCLUDE=true

# 隐藏任务栏图标（true=任务栏与 Alt-Tab 中不显示）
DESKTOP_HIDE_TASKBAR=false

# 窗口透明度（0.2-1.0，1.0=完全不透明；也可写 20-100 的百分数）
# 运行中可在界面顶栏「窗口设置」里拖动滑块实时调整
DESKTOP_OPACITY=1.0

# 指定浏览器可执行文件路径（仅 browser 回退模式使用，留空则自动查找 Edge/Chrome）
# DESKTOP_BROWSER=C:\Program Files\Google\Chrome\Application\chrome.exe

# ── 截图答题（frontend 的「截图答题」页面 / backend 的 /screenshot 接口）──
# 该功能依赖 wgc-python（Windows Graphics Capture），仅支持 Windows 10 2004+
# 安装：pip install wgc-python
SCREENSHOT_ENABLED=true

# 视觉模型名。⚠️ 必须是支持图片输入的模型：
# 纯文本模型（deepseek-v4-flash 等）不具备视觉能力，把图片发给它不会报错，
# 而是忽略图片并编造一个看似合理的答案。
#   现名：deepseek-flash（旧名 deepseek-v4-flash-vision-exp 已下线但仍可调用）
SCREENSHOT_VISION_MODEL=deepseek-flash

# 截图保存目录（相对项目根目录）
SCREENSHOT_DIR=screenshots

# 上传给模型前图片的最长边（像素）。
# 官方会把大图缩放到约 1300×1300 再计费，单图 token 上限 1024，
# 本地先缩小可显著减少上传耗时与流量。
SCREENSHOT_MAX_IMAGE_EDGE=1280

# 单次回答的最大 token 数。
# ⚠️ DeepSeek 思考模式**默认开启**，思维链与正文共享该预算；
#    若值偏小（如 2048），推理会吃光预算导致正文被截断。
SCREENSHOT_MAX_TOKENS=8192

# 截图问答是否启用思考模式。
# 截图答题是「照抄题干 + 给答案」，不需要长链推理，
# 开启只会占用输出预算并拖慢响应，故默认关闭。
SCREENSHOT_THINKING_ENABLED=false

# 是否把每次截图保存到磁盘（false=只识别不留档）
SCREENSHOT_SAVE=true