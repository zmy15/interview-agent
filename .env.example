DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING_ENABLED=true
# 思考强度（reasoning_effort）：low / high / max
#   low  — 更快、更省 output token，适合简单问答
#   high — 官方默认档位
#   max  — 最充分的推理，耗时与 token 消耗最高
# 界面「模型选择器」里的思考强度选择优先于本配置。
DEEPSEEK_REASONING_EFFORT=high
# 仅作为「官方 /models 接口不可用」时的兜底模型清单。
# 正常情况下模型列表由 GET https://api.deepseek.com/models 动态获取，
# 新增 / 改名模型无需改代码，也不用改这里。
AVAILABLE_MODELS=deepseek-v4-pro,deepseek-v4-flash
EMBEDDING_MODEL=all-MiniLM-L6-v2
# --- HuggingFace 镜像（国内用户必配）---
# 国内无法访问 huggingface.co，使用镜像站下载模型
HF_ENDPOINT=https://hf-mirror.com
# 本地缓存目录，避免重复下载（默认为项目目录下的 hf_cache）
# HF_HOME=./hf_cache
CHROMA_PERSIST_PATH=./chroma_data
VECTOR_SEARCH_TOP_K=3

# --- 上下文窗口管理 ---
# DeepSeek V4 支持 1M tokens 上下文窗口
# MAX_CONTEXT_TOKENS: 总 token 预算（默认 800K，留 200K 余量给输出）
# SYSTEM_RESERVED_TOKENS: 为 system 消息（JD/简历/提示模板）预留的 token 数
# MAX_CONTEXT_TOKENS=800000
# SYSTEM_RESERVED_TOKENS=8000
# 日志等级: DEBUG / INFO / WARNING / ERROR（默认 INFO）

LOG_LEVEL=INFO

# RAG 检索增强开关（true=开启，false=关闭）
# - 开启前需安装 RAG 依赖：pip install -r requirements-rag.txt
# - Docker 部署时通过 SKIP_RAG 控制依赖安装，详见 docker-compose.yml
# - 无 CUDA 环境也可使用（自动 CPU 模式），但 torch 包体积较大（~2GB）
RAG_ENABLED=false

# ── 独立窗口模式（python desktop.py 或 start_app.bat）──
# 服务监听地址与端口（独立窗口默认仅本机可访问）
HOST=127.0.0.1
PORT=8000

# 窗口尺寸
DESKTOP_WIDTH=1280
DESKTOP_HEIGHT=800

# 窗口置顶（true=始终显示在其他窗口之上）
DESKTOP_TOPMOST=true

# 从屏幕捕获中排除窗口（true=截屏/录屏看不到窗口内容）
# 注意：仅在 native 窗口（pywebview）下真正生效；
#       若回退到浏览器 --app 模式，受 Windows 跨进程限制无法生效。
DESKTOP_CAPTURE_EXCLUDE=true

# 隐藏任务栏图标（true=任务栏与 Alt-Tab 中不显示）
DESKTOP_HIDE_TASKBAR=false

# 窗口透明度（0.2-1.0，1.0=完全不透明；也可写 20-100 的百分数）
# 运行中可在界面顶栏「窗口设置」里拖动滑块实时调整
DESKTOP_OPACITY=1.0

# 指定浏览器可执行文件路径（仅 browser 回退模式使用，留空则自动查找 Edge/Chrome）
# DESKTOP_BROWSER=C:\Program Files\Google\Chrome\Application\chrome.exe

# ── 截图答题（frontend 的「截图答题」页面 / backend 的 /screenshot 接口）──
# 该功能依赖 wgc-python（Windows Graphics Capture），仅支持 Windows 10 2004+
# 安装：pip install wgc-python
SCREENSHOT_ENABLED=true

# 视觉模型不再写死：截图默认使用界面「模型选择器」中选中的模型，
# 后端通过官方 GET /models 的 input_modalities 判断它是否支持图片输入；
# 不支持时直接返回「不支持图片输入」，不会把图片发给纯文本模型
# （纯文本模型收到图片不报错，而是忽略图片并编造一个看似合理的答案）。
#
# 本项只在「界面未选择任何模型」时作为兜底偏好，
# 留空则自动挑选账号下第一个支持图片输入的模型（如 deepseek-flash）。
SCREENSHOT_VISION_MODEL=

# 截图保存目录（相对项目根目录）
SCREENSHOT_DIR=screenshots

# 上传给模型前图片的最长边（像素）。
# 官方会把大图缩放到约 1300×1300 再计费，单图 token 上限 1024，
# 本地先缩小可显著减少上传耗时与流量。
SCREENSHOT_MAX_IMAGE_EDGE=1280

# 单次回答的最大 token 数。
# ⚠️ DeepSeek 思考模式**默认开启**，思维链与正文共享该预算；
#    若值偏小（如 2048），推理会吃光预算导致正文被截断。
SCREENSHOT_MAX_TOKENS=8192

# 截图问答在「界面未传思考开关」时的默认值。
# 截图答题是「照抄题干 + 给答案」，不需要长链推理，
# 开启只会占用输出预算并拖慢响应，故默认关闭。
# ⚠️ 界面上的「思考模式」开关优先于本配置（点截图按钮时会一并透传）。
SCREENSHOT_THINKING_ENABLED=false

# 是否把每次截图保存到磁盘（false=只识别不留档）
SCREENSHOT_SAVE=true

# ── 系统音频捕获（捕获电脑播放的声音 → STT 转文字）──
# 与截图答题对称：截图抓「屏幕上看到的」，这个抓「扬声器里放的」。
# 面试时对方的提问往往来自会议软件/视频/网页播放，麦克风录不到，
# 这里通过 Windows WASAPI 回环直接从扬声器设备抓取。
# 依赖：pip install soundcard（仅 Windows 可用）
# 接口：/system-audio/info|devices|status|start|stop|transcript|clear
SYSTEM_AUDIO_ENABLED=true

# 要捕获的播放设备 id。留空 = 系统默认播放设备。
# 可选值见 GET /system-audio/devices（每台扬声器都能回环抓取）。
SYSTEM_AUDIO_DEVICE=

# 每次从回环读取的音频块长度（毫秒）。
# 100ms 与 stt_service 的帧约定一致，改小会增加线程唤醒频率。
SYSTEM_AUDIO_BLOCK_MS=100

# 启动服务时是否自动开始捕获（默认 true = 打开就能用）。
# 设为 false 则需在界面「设置 → 监听系统音频」里手动打开，
# 或由前端/接口调用 POST /system-audio/start。
SYSTEM_AUDIO_AUTOSTART=true

# 转写结果在内存中保留的条数上限（前端按 seq 增量拉取）
SYSTEM_AUDIO_TRANSCRIPT_BUFFER=200

# ⚠️ 使用前提：音频转写依赖 STT 微服务。请确认
#   1) VOICE_ENABLED=true 或 STT_ENABLED=true（注册 /stt 路由）
#   2) stt 服务已启动（docker compose --profile stt up，或本地跑 stt_service）
#   3) STT_SERVICE_URL 指向它
#  STT 未就绪时捕获仍会运行，只是不产生文字，状态里会带 stt_error 说明原因。

# ── 语音功能开关（默认全部关闭，需主动启用） ──
# 语音总开关
VOICE_ENABLED=false
# STT 语音识别独立开关
STT_ENABLED=false
# TTS 语音合成独立开关
TTS_ENABLED=false

# ── STT 分块（VAD 断句 与 Whisper 分块 解耦）──
#
# 背景：早期 VAD 自带 max_speech_duration=30s，到点就把连续语音
#   强行切开并送 Whisper。一段 2~3 分钟、中途没有长停顿的自我介绍
#   因此被切成好几段碎片，切点落在词中间且互不共享上下文，
#   表现为「被分成好几次才发送、中间不连贯、缺少信息」。
# 现在的策略：
#   1. VAD 只判断「有没有人在说话」，不再决定切多长；
#   2. 优先在自然停顿处收块（语义边界）；
#   3. 连续语音超过上限才硬切，硬切带重叠且不丢音频；
#   4. 每块注入上一块尾部文本作为上文提示，并做重叠去重。

# 连续语音的硬上限（秒）。越大 → 块越长、上下文越完整，但单块识别更慢、
# 延迟更高。25s 是「一段正常回答中途总会有换气」的折中值。
STT_CHUNK_MAX_SECONDS=25

# 硬切时前后块的重叠时长（秒）。保证切点处的字至少被识别一次，
# 重叠产生的重复文本会自动去重。设为 0 则关闭（不推荐）。
STT_CHUNK_OVERLAP_SECONDS=0.5

# 跨块上下文长度（字符）。把上一块尾部这么多字符拼进 initial_prompt，
# 让 Whisper 知道前文在讲什么。0 = 关闭（回到每块完全独立）。
# 注意 Whisper 的 prompt 上限约 224 token，不建议超过 150。
STT_CHUNK_CONTEXT_CHARS=120

# --- 认证（登录）---

# 是否要求登录。
#   true  —— 需要注册/登录，每个用户各自的数据相互隔离（网页版默认）
#   false —— 单用户模式，免登录；所有数据归属固定的本机账号 desktop@local
#
# 桌面版（start_app.bat / desktop.py）**默认按 false 运行**，即使这里不写，
# 双击启动也不会出现登录页。写 true 可以强制桌面版也走登录流程。
#
# 注意：这不只是「关掉一个提示」。开启单用户模式后，岗位 / 题库 / 会话 /
# 上传 / 分析等原本要求 token 的接口都会自动使用本机账号，
# 因此桌面版能与网页版拥有一致的完整功能。
#
# 留空 / 不写时：网页版按 true（需登录），桌面版按 false（免登录）。
# AUTH_REQUIRED=true